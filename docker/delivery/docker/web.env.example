# Docker 公共版前端运行时配置（示例）
# 复制为：docker/web.local.env
# cp docker/web.env.example docker/web.local.env

# FRONT_API_BASE 通常留空，前端会自动走同源代理。
# 普通用户不需要在页面里看到或填写 API Base。
FRONT_API_BASE=

# 这里必须和 docker/auth.local.local.json 里的某一个后端 key 保持一致。
# 前端会自动带上这个后端鉴权 key。
FRONT_X_API_KEY=replace-with-your-backend-key

# 前端默认 OCR provider。
# 可选：mineru_local | mineru | paddle
FRONT_OCR_PROVIDER=mineru_local

# 可选的 OCR / 模型默认配置。
# 如果希望最终用户在浏览器里自己填写 OCR / 模型配置，就保持为空。
FRONT_PADDLE_TOKEN=
FRONT_MINERU_TOKEN=

# OpenAI 兼容模型配置（页面默认值）
FRONT_MODEL_API_KEY=replace-with-your-model-api-key
FRONT_MODEL=glm-4-flash
FRONT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
