# RetainPDF app container runtime configuration (example)
# Copy to: docker/delivery/docker/app.local.env

# Container-internal project paths
PROJECT_ROOT=/app
RUST_API_ROOT=/app/backend/rust_api
RUST_API_DATA_ROOT=/data
OUTPUT_ROOT=/data/jobs

# Executable paths inside container
PYTHON_BIN=python3
TYPST_BIN=/usr/local/bin/typst

# Default font settings used by Typst rendering
RETAIN_PDF_FONT_PATH=/usr/local/share/fonts/source-han-serif/SourceHanSerifSC-Regular.otf
RETAIN_PDF_TYPST_FONT_FAMILY=Source Han Serif SC

# API bind settings inside container
RUST_API_BIND_HOST=0.0.0.0
RUST_API_PORT=41000
RUST_API_SIMPLE_PORT=42000

# MinerU bridge endpoint from container perspective
# macOS/Windows Docker Desktop usually works with host.docker.internal
RETAIN_MINERU_LOCAL_BASE_URL=http://host.docker.internal:18080

# Runtime limits
RUST_API_MAX_RUNNING_JOBS=4
RUST_API_NORMAL_MAX_BYTES=209715200
RUST_API_NORMAL_MAX_PAGES=300
