FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/models/mineru \
    HF_HOME=/models/mineru/.cache/huggingface \
    MODELSCOPE_CACHE=/models/mineru/.cache/modelscope \
    MINERU_MODEL_SOURCE=local \
    MINERU_API_HOST=0.0.0.0 \
    MINERU_API_PORT=8000

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fontconfig \
    fonts-noto-cjk \
    fonts-noto-core \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip uv \
    && uv pip install --system --no-cache -U "mineru[core]"

COPY docker/entrypoint-mineru.sh /entrypoint-mineru.sh
RUN chmod +x /entrypoint-mineru.sh && mkdir -p /models/mineru

VOLUME ["/models/mineru"]
EXPOSE 8000

ENTRYPOINT ["/entrypoint-mineru.sh"]
